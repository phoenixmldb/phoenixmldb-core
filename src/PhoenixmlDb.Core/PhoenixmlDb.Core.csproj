<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <MobileCompatible>true</MobileCompatible>
    <RootNamespace>PhoenixmlDb.Core</RootNamespace>
    <Description>Core types, XDM data model, and interfaces for PhoenixmlDb document database</Description>
    <PackageTags>xml;json;database;xquery;xdm;embedded;ios;android;mobile;maui</PackageTags>
    <!-- CA1043: MetadataCollection's XdmQName-keyed indexer is the intentional storage/index
         key type for this design (see Metadata/MetadataCollection.cs) — not an oversight. -->
    <NoWarn>$(NoWarn);CA1711;CA1028;CA1054;CA1055;CA1056;CA1062;CA1820;CS0649;CA1043</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhoenixmlDb.Xslt" />
    <InternalsVisibleTo Include="PhoenixmlDb.XQuery" />
    <InternalsVisibleTo Include="PhoenixmlDb.Xdm.Tests" />
    <InternalsVisibleTo Include="PhoenixmlDb.Core.Tests" />
    <!-- Both XQuery CLI builds (in-repo and the separate phoenixmldb-cli repo)
         compile to assembly name "xquery"; this grants them the shared escaper. -->
    <InternalsVisibleTo Include="xquery" />
  </ItemGroup>

</Project>
